# neo4j
NEO4J_USER=neo4j
NEO4J_PASSWORD=cache_neo4j_pass
NEO4J_URI=bolt://localhost:7687

# redis
REDIS_PASSWORD=cache_redis_pass
REDIS_URI=redis://:cache_redis_pass@localhost:6379

# mongodb
MONGO_USER=cache_admin
MONGO_PASSWORD=cache_mongo_pass
MONGO_DB=cache_db
MONGO_URI=mongodb://cache_admin:cache_mongo_pass@localhost:27017/cache_db?authSource=admin

# cassandra
CASSANDRA_USER=cassandra
CASSANDRA_PASSWORD=cache_cassandra_pass
CASSANDRA_KEYSPACE=cache_ks
CASSANDRA_CONTACT_POINTS=localhost

# mongo express (admin ui — solo dev)
ME_CONFIG_BASICAUTH_USERNAME=admin
ME_CONFIG_BASICAUTH_PASSWORD=admin_pass

# spring boot
SPRING_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# auth (jwt) — el secret DEBE tener al menos 32 bytes
JWT_SECRET=dev-secret-cambiar-en-prod-min-32-bytes-larguisimo
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# next.js
NEXT_PUBLIC_API_URL=http://localhost:8080
