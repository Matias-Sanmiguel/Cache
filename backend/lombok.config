# raíz de config Lombok del módulo backend
config.stopBubbling = true

# copiar @Qualifier (y @Value de Spring) al parámetro del constructor generado por
# @RequiredArgsConstructor — si no, el @Qualifier puesto en el field se pierde y la
# inyección queda ambigua cuando hay más de un bean del mismo tipo (ej: 2 CassandraTemplate).
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Qualifier
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Value
